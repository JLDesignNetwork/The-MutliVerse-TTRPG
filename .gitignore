# The Multiverse TTRPG Framework — .gitignore

# 1. AI Agents, Development Configs & Staging (Gitignored by Default)
.*/

# Exception: Allow GitHub Actions workflows and CI scripts
!.github/
!.github/**

# 2. Node & Next.js Web Application
node_modules/
.next/
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tsconfig.tsbuildinfo

# 3. Presentation & Book Build Artifacts
_homebrewery/master_brew.txt
*.pdf

# 4. Scratch & Temporary Files
scratch/
tmp/
*.tmp

# 5. OS & File System Artifacts
.DS_Store
Thumbs.db
