# The Multiverse TTRPG Framework — .gitignore

# Ignore all dot-directories (AI agents, dev configs, IDEs)
.*/

# Exception: allow GitHub workflows and CI scripts
!.github/
!.github/**

# Node / Next.js web application
node_modules/
.next/
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tsconfig.tsbuildinfo

# Homebrewery compiled output artifacts
_homebrewery/master_brew.txt
*.pdf

# OS & Editor Artifacts
.DS_Store
Thumbs.db
